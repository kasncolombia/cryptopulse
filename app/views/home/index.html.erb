        <p class="text-[11px] font-medium text-slate-500 dark:text-[#8B8FA8]"><%= cat[:c] %> artículos</p>
      </a>
    <% end %>
  </div>
</div>

<%# Value Props %>
<div class="grid grid-cols-2 xl:grid-cols-4 gap-px bg-slate-200 dark:bg-[#2A2D4A] border-t border-slate-200 dark:border-[#2A2D4A]">
  <% [
      {label:'Aprende',  sub:'Cursos desde cero',      icon:'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253', bg:'bg-indigo-50 dark:bg-[#1E2140]', tc:'text-[#4F46E5]'},
      {label:'Analiza',  sub:'Datos on-chain en vivo', icon:'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z', bg:'bg-emerald-50 dark:bg-[#1E2140]', tc:'text-emerald-500'},
      {label:'Conecta',  sub:'Comunidad experta',      icon:'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z', bg:'bg-orange-50 dark:bg-[#1E2140]', tc:'text-[#F59E0B]'},
      {label:'Gana',     sub:'Rentabiliza portafolio', icon:'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6', bg:'bg-purple-50 dark:bg-[#1E2140]', tc:'text-[#A855F7]'}
     ].each do |prop| %>
    <div class="bg-white dark:bg-[#0D0E1A] p-6 lg:p-8 flex items-center gap-5">
      <div class="w-12 h-12 rounded-xl <%= prop[:bg] %> flex items-center justify-center shrink-0 <%= prop[:tc] %>">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= prop[:icon] %>"/></svg>
      </div>
      <div>
        <p class="text-[16px] font-extrabold text-slate-900 dark:text-white"><%= prop[:label] %></p>
        <p class="text-[12px] font-medium text-slate-500 dark:text-[#8B8FA8]"><%= prop[:sub] %></p>
      </div>
    </div>
  <% end %>
</div>

<style>
  @keyframes marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(calc(-220px * 10)); }
  }
  .animate-marquee {
    animation: marquee 35s linear infinite;
    will-change: transform;
  }
</style>
