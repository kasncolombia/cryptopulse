<%# Vista: Leer Noticia (detalle de artículo) %>
<% content_for :title, "#{@article[:title]} | CryptoSphere" %>

<div class="p-6 sm:p-8 bg-slate-50 dark:bg-[#0D0E1A] min-h-full">

  <%# Breadcrumb %>
  <div class="flex items-center gap-2 text-[13px] text-slate-500 dark:text-[#5A5F7A] mb-6">
    <a href="<%= root_path %>" class="hover:text-[#4F46E5] transition-colors">Inicio</a>
    <span>›</span>
    <a href="<%= news_index_path %>" class="hover:text-[#4F46E5] transition-colors">Noticias</a>
    <span>›</span>
    <span class="text-slate-900 dark:text-white font-medium line-clamp-1"><%= @article[:title][0..50] %>...</span>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-8 max-w-[1200px]">

    <%# Article Main Content %>
    <article class="xl:col-span-2">

      <%# Category + Meta %>
      <div class="flex flex-wrap items-center gap-3 mb-5">
        <span class="px-3 py-1.5 rounded-full text-[12px] font-extrabold uppercase tracking-wider text-white" style="background-color:#60A5FA"><%= @article[:category] %></span>
        <span class="text-[13px] text-slate-500 dark:text-[#5A5F7A]"><%= @article[:time] %></span>
        <span class="text-slate-300 dark:text-[#2A2D4A]">•</span>
        <span class="text-[13px] text-slate-500 dark:text-[#5A5F7A]">⏱ <%= @article[:read_time] %> de lectura</span>
      </div>

      <%# Title %>
      <h1 class="text-[28px] sm:text-[34px] font-extrabold text-slate-900 dark:text-white leading-tight tracking-tight mb-5">
        <%= @article[:title] %>
      </h1>

      <%# Author %>
      <div class="flex items-center gap-3 mb-7 pb-6 border-b border-slate-200 dark:border-[#2A2D4A]">
        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-[#4F46E5] to-[#A855F7] flex items-center justify-center font-bold text-white text-sm">CP</div>
        <div>
          <p class="text-[14px] font-bold text-slate-900 dark:text-white"><%= @article[:author] || 'Analista Cripto' %></p>
          <p class="text-[12px] text-slate-500 dark:text-[#5A5F7A]">Análisis & Mercados</p>
        </div>
        <div class="ml-auto flex items-center gap-2">
          <button class="p-2 rounded-lg bg-slate-100 dark:bg-[#1A1D35] text-slate-600 dark:text-[#8B8FA8] hover:bg-slate-200 dark:hover:bg-[#2A2D4A] transition-colors" title="Compartir">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
          </button>
          <button class="p-2 rounded-lg bg-slate-100 dark:bg-[#1A1D35] text-slate-600 dark:text-[#8B8FA8] hover:bg-slate-200 dark:hover:bg-[#2A2D4A] transition-colors" title="Guardar">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
          </button>
        </div>
      </div>

      <%# Hero Image %>
      <% if @article[:image] %>
        <div class="rounded-2xl overflow-hidden mb-8">
          <img src="<%= @article[:image] %>" alt="<%= @article[:title] %>" class="w-full h-[300px] sm:h-[380px] object-cover">
        </div>
      <% else %>
        <div class="rounded-2xl overflow-hidden mb-8 bg-gradient-to-br from-indigo-600 to-purple-700 h-[300px] sm:h-[380px] flex items-center justify-center">
          <span class="text-[80px] text-white/30">₿</span>
        </div>
      <% end %>

      <%# Article Body %>
      <div class="prose prose-slate dark:prose-invert max-w-none text-[15px] leading-relaxed text-slate-700 dark:text-[#C5C7D4] space-y-5">
        <%= simple_format(@article[:content], class: 'text-[17px] font-semibold text-slate-800 dark:text-slate-200 leading-relaxed') %>
      </div>

      <%# Back Button %>
      <div class="mt-8">
        <a href="<%= news_index_path %>" class="inline-flex items-center gap-2 text-[14px] font-bold text-[#4F46E5] hover:text-[#6C7AE0] transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Volver a Noticias
        </a>
      </div>
    </article>

    <%# Sidebar %>
    <aside class="space-y-6">
      <%# Related Articles %>
      <div class="bg-white dark:bg-[#13152B] rounded-2xl border border-slate-200 dark:border-[#2A2D4A] p-6">
        <h3 class="text-[15px] font-bold text-slate-900 dark:text-white mb-5">📰 Artículos Relacionados</h3>
        <div class="space-y-4">
          <% @news.select { |n| n[:id] != @article[:id] }.first(3).each do |rel| %>
            <a href="<%= news_path(rel[:slug]) %>" class="flex gap-3 group">
              <div class="w-1.5 h-1.5 rounded-full bg-[#4F46E5] mt-2 shrink-0"></div>
              <div>
                <p class="text-[13px] font-bold text-slate-800 dark:text-white group-hover:text-[#4F46E5] transition-colors leading-snug line-clamp-2"><%= rel[:title][0..60] %>...</p>
                <p class="text-[11px] text-slate-400 dark:text-[#5A5F7A] mt-0.5"><%= rel[:category] %> · <%= rel[:time] %></p>
              </div>
            </a>
          <% end %>
        </div>
      </div>

      <%# Newsletter %>
      <div class="rounded-2xl bg-gradient-to-br from-indigo-600 to-purple-700 p-6 text-white">
        <div class="text-2xl mb-3">📬</div>
        <h3 class="text-[16px] font-bold mb-1">El Daily Pulse</h3>
        <p class="text-[13px] text-indigo-100 mb-4">Análisis crypto institucional en tu bandeja cada mañana.</p>
        <input type="email" placeholder="tu@email.com" class="w-full bg-white/10 border border-white/20 rounded-xl py-2.5 px-4 text-white placeholder:text-indigo-200 text-[13px] outline-none focus:bg-white/20 transition mb-3">
        <button class="w-full py-2.5 bg-white text-indigo-700 font-bold text-[13px] rounded-xl hover:bg-indigo-50 transition-colors">Suscribirme gratis</button>
        <p class="text-[11px] text-indigo-200 text-center mt-3">Únete a +85,000 traders</p>
      </div>
    </aside>
  </div>
</div>
