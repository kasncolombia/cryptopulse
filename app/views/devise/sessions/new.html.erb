<%# Login - CryptoSphere Hyper-Fintech Style %>
<div class="min-h-screen bg-[#11131c] flex items-center justify-center p-5 relative overflow-hidden">
  <%# Ambient glows %>
  <div class="fixed top-[-10%] left-[-10%] w-[40%] h-[40%] bg-indigo-500/10 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="fixed bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-purple-500/10 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="w-full max-w-[440px] z-10">
    <%# Brand %>
    <div class="text-center mb-8">
      <a href="<%= root_path %>" class="inline-flex items-center gap-2 mb-4">
        <div class="w-9 h-9 rounded-lg bg-gradient-to-tr from-[#4F46E5] to-[#7C3AED] flex items-center justify-center font-bold text-white shadow-lg">CS</div>
        <span class="text-[22px] font-extrabold bg-gradient-to-r from-indigo-400 to-purple-400 bg-clip-text text-transparent">CryptoSphere</span>
      </a>
      <h1 class="text-[24px] font-bold text-white">Bienvenido de nuevo</h1>
      <p class="text-[14px] text-slate-400 mt-1">Accede al terminal de trading profesional</p>
    </div>

    <%# Alerts %>
    <% if notice %><div class="mb-4 p-3 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-emerald-400 text-[13px] font-medium"><%= notice %></div><% end %>
    <% if alert %><div class="mb-4 p-3 bg-rose-500/10 border border-rose-500/30 rounded-xl text-rose-400 text-[13px] font-medium"><%= alert %></div><% end %>

    <%# Card with glass effect %>
    <div class="bg-[#1d1f29]/70 backdrop-blur-xl border border-white/10 rounded-2xl p-8 shadow-2xl">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="space-y-5">
          <div>
            <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Dirección de Email</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-xl">mail</span>
              <%= f.email_field :email, autofocus: true, autocomplete: "email",
                    class: "w-full bg-[#0c0e17] border border-[#464554] focus:border-[#c0c1ff] rounded-xl py-3 pl-11 pr-4 text-white placeholder:text-slate-600 text-[14px] outline-none transition-all",
                    placeholder: "nombre@ejemplo.com" %>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider">Contraseña</label>
              <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
                <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: "text-[12px] text-indigo-400 hover:text-indigo-300 transition-colors" %>
              <% end %>
            </div>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-xl">lock</span>
              <%= f.password_field :password, autocomplete: "current-password",
                    class: "w-full bg-[#0c0e17] border border-[#464554] focus:border-[#c0c1ff] rounded-xl py-3 pl-11 pr-4 text-white placeholder:text-slate-600 text-[14px] outline-none transition-all",
                    placeholder: "••••••••" %>
            </div>
          </div>

          <% if devise_mapping.rememberable? %>
            <label class="flex items-center gap-2 cursor-pointer">
              <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-[#464554] bg-[#0c0e17] text-indigo-500 focus:ring-indigo-500 focus:ring-offset-0" %>
              <span class="text-[13px] text-slate-400">Mantener sesión iniciada</span>
            </label>
          <% end %>

          <%= f.submit "Iniciar Sesión", class: "w-full py-3.5 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 text-white font-bold text-[15px] rounded-xl shadow-lg shadow-indigo-500/25 transition-all active:scale-[0.98] cursor-pointer" %>
        </div>
      <% end %>

      <div class="relative my-6 flex items-center gap-3">
        <div class="flex-grow border-t border-white/10"></div>
        <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wider">O continuar con</span>
        <div class="flex-grow border-t border-white/10"></div>
      </div>

      <button class="w-full flex items-center justify-center gap-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl py-3 text-white font-medium text-[14px] transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        Continuar con Google
      </button>
    </div>

    <p class="text-center text-[14px] text-slate-500 mt-6">
      ¿No tienes una cuenta?
      <%= link_to "Crear cuenta", new_registration_path(resource_name), class: "text-indigo-400 font-bold hover:text-indigo-300 ml-1 transition-colors" %>
    </p>

    <%# Trust badges %>
    <div class="flex justify-center gap-8 mt-6">
      <% [['🔒', 'SEGURIDAD 2FA'], ['🏦', 'CUSTODIA FRÍA'], ['⚡', 'EJECUCIÓN RÁPIDA']].each do |icon, label| %>
        <div class="text-center">
          <div class="text-xl mb-1"><%= icon %></div>
          <p class="text-[10px] font-bold text-slate-600 uppercase tracking-wider"><%= label %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
