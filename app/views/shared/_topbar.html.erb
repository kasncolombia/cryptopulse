<%# TOPBAR — CryptoSphere con Material Symbols %>
<header class="h-16 px-4 sm:px-6 flex items-center justify-between bg-white/80 dark:bg-[#0c0e17]/80 backdrop-blur-md border-b border-slate-200 dark:border-white/10 z-50 shrink-0 transition-colors duration-300"
        data-controller="mobile-menu">

  <%# Left side: Menu + Logo %>
  <div class="flex items-center gap-3 sm:gap-6">
    <button data-action="click->mobile-menu#toggle"
            class="lg:hidden p-2 -ml-1 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
      <span class="material-symbols-outlined" data-mobile-menu-target="iconOpen">menu</span>
      <span class="material-symbols-outlined hidden" data-mobile-menu-target="iconClose">close</span>
    </button>

    <a href="<%= root_path %>" class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-[#4F46E5] to-[#7C3AED] flex items-center justify-center font-bold text-white text-sm shadow-lg shadow-indigo-500/20">
        CS
      </div>
      <span class="font-bold text-[18px] sm:text-[20px] tracking-tight hidden sm:block text-slate-900 dark:text-white">CryptoSphere</span>
    </a>
  </div>

  <%# Center: Nav Links %>
  <nav class="hidden lg:flex items-center gap-1">
    <a href="<%= root_path %>" class="px-4 py-2 text-[14px] font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">Mercado</a>
    <a href="<%= news_index_path %>" class="px-4 py-2 text-[14px] font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">Noticias</a>
    <a href="<%= categories_path %>" class="px-4 py-2 text-[14px] font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">Academia</a>
  </nav>

  <%# Right side: Actions %>
  <div class="flex items-center gap-2 sm:gap-3">
    <%# API Status Badge %>
    <div class="hidden md:flex items-center gap-2 px-2.5 py-1.5 rounded-lg border transition-colors <%= ENV['COINGECKO_API_KEY'].present? ? 'bg-emerald-500/10 border-emerald-500/30' : 'bg-rose-500/10 border-rose-500/30' %>">
      <span class="relative flex h-2 w-2">
        <% if ENV['COINGECKO_API_KEY'].present? %>
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
        <% else %>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-400"></span>
        <% end %>
      </span>
      <span class="text-[11px] font-bold uppercase tracking-wider <%= ENV['COINGECKO_API_KEY'].present? ? 'text-emerald-400' : 'text-rose-400' %>">
        <%= ENV['COINGECKO_API_KEY'].present? ? 'API Live' : 'API Off' %>
      </span>
    </div>

    <%# Search (xl+) %>
    <div class="relative hidden xl:block">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 dark:text-slate-400 text-xl">search</span>
      <input type="text" placeholder="Buscar activos..." class="h-9 w-56 pl-9 pr-3 bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-lg text-[13px] text-slate-900 dark:text-white placeholder:text-slate-500 dark:placeholder:text-slate-400 focus:outline-none focus:border-indigo-500 transition-colors">
    </div>

    <%# Dark Mode Toggle %>
    <button data-action="click->theme#toggle" class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
      <span class="material-symbols-outlined" data-theme-target="lightIcon">light_mode</span>
      <span class="material-symbols-outlined hidden" data-theme-target="darkIcon">dark_mode</span>
    </button>

    <%# Notifications %>
    <button class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition-colors relative">
      <span class="material-symbols-outlined">notifications</span>
      <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-rose-500 border-2 border-[#0c0e17]"></span>
    </button>

    <%# User Avatar %>
    <a href="<%= profile_path %>" class="flex items-center gap-2 ml-1 pl-3 border-l border-slate-200 dark:border-white/10 hover:opacity-80 transition-opacity">
      <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#4F46E5] to-[#A855F7] p-[2px] shrink-0">
        <div class="w-full h-full rounded-full bg-slate-900 dark:bg-[#0c0e17] flex items-center justify-center text-[11px] font-bold text-white">AR</div>
      </div>
      <div class="hidden sm:flex flex-col">
        <span class="text-[12px] font-bold leading-tight text-slate-900 dark:text-white">Alex Rivera</span>
        <span class="text-[10px] font-bold text-indigo-400 uppercase tracking-wider">PRO</span>
      </div>
    </a>
  </div>

  <%# Mobile Slide-in Menu %>
  <div data-mobile-menu-target="drawer"
       class="hidden fixed inset-0 z-[9999] lg:hidden">
    <%# Backdrop %>
    <div data-action="click->mobile-menu#close"
         class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <%# Drawer panel %>
    <div class="absolute left-0 top-0 h-screen w-72 bg-white dark:bg-[#0c0e17] shadow-2xl flex flex-col overflow-y-auto">
      <%# Header del drawer %>
      <div class="flex items-center justify-between px-5 py-4 border-b border-slate-200 dark:border-white/10">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-[#4F46E5] to-[#7C3AED] flex items-center justify-center font-bold text-white text-sm">CS</div>
          <span class="font-bold text-[18px] text-slate-900 dark:text-white">CryptoSphere</span>
        </div>
        <button data-action="click->mobile-menu#close" class="p-1 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <%# Nav links %>
      <nav class="flex-1 p-4 space-y-1">
        <% [
            {href: root_path,         label: 'Inicio',     icon: 'home'},
            {href: news_index_path,   label: 'Noticias',   icon: 'newspaper'},
            {href: categories_path,   label: 'Academia',   icon: 'school'},
            {href: profile_path,      label: 'Mi Perfil',  icon: 'account_balance_wallet'}
           ].each do |item| %>
          <a href="<%= item[:href] %>"
             class="flex items-center gap-3 px-4 py-3 rounded-xl text-[15px] font-semibold transition-all <%= current_page?(item[:href]) ? 'bg-indigo-500/20 text-indigo-400' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5' %>">
            <span class="material-symbols-outlined"><%= item[:icon] %></span>
            <%= item[:label] %>
          </a>
        <% end %>
        <div class="h-px bg-slate-200 dark:bg-white/10 my-3"></div>
        <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl text-[15px] font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5">
          <span class="material-symbols-outlined">bar_chart</span>
          Mercado
        </a>
        <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl text-[15px] font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5">
          <span class="material-symbols-outlined">pie_chart</span>
          Portafolio
        </a>
        <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl text-[15px] font-semibold text-slate-400 hover:text-white hover:bg-white/5">
          <span class="material-symbols-outlined">groups</span>
          Comunidad
        </a>
      </nav>
      <%# PRO CTA %>
      <div class="p-4 border-t border-white/10">
        <div class="p-4 rounded-2xl bg-gradient-to-br from-indigo-600 to-purple-800 border border-white/10">
          <p class="text-[14px] font-bold text-white mb-1">✨ Upgrade a PRO</p>
          <p class="text-[12px] text-indigo-200 mb-3">Desbloquea datos on-chain exclusivos.</p>
          <button class="w-full py-2.5 bg-white text-indigo-600 text-[13px] font-bold rounded-xl hover:bg-indigo-50 transition-colors">Ver Planes</button>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
.material-symbols-outlined {
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}
</style>
