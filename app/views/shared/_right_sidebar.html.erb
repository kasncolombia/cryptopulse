<%# Fetch coin data for watchlist %>
<% 
begin
  watchlist_coins = ExternalApis::CoinGeckoClient.fetch_coins_markets('bitcoin,ethereum,solana,ripple,cardano')
rescue
  watchlist_coins = []
end

# Map to usable format
if watchlist_coins.present?
  watchlist_data = watchlist_coins.map do |c|
    {
      s: c['symbol']&.upcase,
      n: c['name'],
      p: c['current_price'],
      c: c['price_change_percentage_24h'],
      up: c['price_change_percentage_24h'].to_f >= 0,
      img: c['image']
    }
  end
else
  # Fallback
  watchlist_data = [
    {s: 'BTC', n: 'Bitcoin', p: 64320, c: 2.4, up: true, img: nil},
    {s: 'ETH', n: 'Ethereum', p: 3450, c: 1.8, up: true, img: nil},
    {s: 'SOL', n: 'Solana', p: 145.8, c: -0.5, up: false, img: nil},
    {s: 'XRP', n: 'XRP', p: 0.62, c: 0.1, up: true, img: nil},
    {s: 'ADA', n: 'Cardano', p: 0.45, c: -1.2, up: false, img: nil}
  ]
end
%>

<aside class="w-[320px] hidden xl:flex flex-col border-l border-slate-200 dark:border-[#2A2D4A] bg-white dark:bg-[#10122A] shrink-0 transition-colors duration-300">
  
  <%# Watchlist Section %>
  <div class="p-6 border-b border-slate-200 dark:border-[#2A2D4A]">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-[15px] font-extrabold text-slate-900 dark:text-white">Mi Watchlist</h3>
      <button class="text-slate-500 dark:text-[#5A5F7A] hover:text-slate-900 dark:hover:text-white"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg></button>
    </div>
    <div class="flex flex-col gap-1.5">
      <% watchlist_data.each do |item| %>
        <a href="<%= coin_path(item[:s].downcase) %>" class="flex items-center justify-between py-2.5 border-b border-slate-100 dark:border-[#1E2140] last:border-0 cursor-pointer hover:bg-slate-50 dark:hover:bg-[#1E2140] px-2 -mx-2 rounded-lg transition-colors">
          <div class="flex items-center gap-3.5">
            <% if item[:img].present? %>
              <img src="<%= item[:img] %>" alt="<%= item[:n] %>" class="w-9 h-9 rounded-full object-cover">
            <% else %>
              <div class="w-9 h-9 rounded-full bg-indigo-500 flex items-center justify-center text-[11px] font-bold text-white"><%= item[:s][0] %></div>
            <% end %>
            <div class="flex flex-col">
              <span class="text-[14px] font-bold text-slate-900 dark:text-white font-mono">$<%= number_to_currency(item[:p] || 0, unit: '', precision: item[:p].to_i < 1 ? 4 : 0) %></span>
              <span class="text-[12px] font-bold" style="color: <%= item[:up] ? '#22C55E' : '#EF4444' %>"><%= item[:up] ? '+' : '' %><%= (item[:c] || 0).round(1) %>%</span>
            </div>
          </div>
          <div class="w-[54px] h-[22px]">
            <svg viewBox="0 0 100 20" preserveAspectRatio="none" class="w-full h-full opacity-80"><path d="<%= item[:up] ? 'M0 15 L30 10 L60 12 L100 2' : 'M0 5 L30 8 L60 4 L100 15' %>" fill="none" stroke="<%= item[:up] ? '#22C55E' : '#EF4444' %>" stroke-width="2.5" /></svg>
          </div>
        </a>
      <% end %>
    </div>
  </div>

  <%# Community Feed %>
  <div class="p-6 flex-1 overflow-y-auto custom-scrollbar flex flex-col">
    <div class="flex items-center justify-between mb-5 shrink-0">
      <h3 class="text-[15px] font-extrabold text-slate-900 dark:text-white">Comunidad</h3>
      <span class="flex h-2.5 w-2.5 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#22C55E] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#22C55E]"></span>
      </span>
    </div>
    
    <div class="flex flex-col flex-1">
      <% [
          {n: 'CryptoWhale', a: 'CW', text: 'Acumulando ETH a estos precios. El soporte de $3,400 parece muy fuerte. 🚀', t: '12 min'},
          {n: 'SatoshiFan', a: 'SF', text: '¿Vieron el último dato de inflación? Bullish para BTC a corto plazo.', t: '45 min'}
         ].each do |post| %>
        <div class="py-5 border-b border-slate-100 dark:border-[#1E2140] last:border-0">
          <div class="flex items-center gap-3 mb-2.5">
            <div class="w-[28px] h-[28px] rounded-full bg-gradient-to-tr from-[#4F46E5] to-[#4C1D95] flex items-center justify-center text-[10px] font-bold text-white shadow-sm"><%= post[:a] %></div>
            <span class="text-[14px] font-bold text-slate-900 dark:text-white"><%= post[:n] %></span>
            <span class="text-[11px] font-medium text-slate-500 dark:text-[#5A5F7A] ml-auto"><%= post[:t] %></span>
          </div>
          <p class="text-[13px] font-medium text-slate-600 dark:text-[#8B8FA8] leading-relaxed mb-4"><%= post[:text] %></p>
          <div class="flex gap-5 text-slate-500 dark:text-[#5A5F7A]">
            <button class="flex items-center gap-1.5 hover:text-[#22C55E] transition-colors"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" /></svg><span class="text-[12px] font-bold">12</span></button>
            <button class="flex items-center gap-1.5 hover:text-[#4F46E5] transition-colors"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg><span class="text-[12px] font-bold">4</span></button>
          </div>
        </div>
      <% end %>
    </div>

    <%# Create Post CTA %>
    <button class="mt-6 w-full py-3 bg-white dark:bg-transparent border border-slate-200 dark:border-[#2A2D4A] hover:bg-slate-50 dark:hover:bg-[#1E2140] text-slate-700 dark:text-white text-[14px] font-bold rounded-xl flex items-center justify-center gap-2 transition-colors shadow-sm shrink-0">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
      Crear publicación
    </button>
  </div>
</aside>
